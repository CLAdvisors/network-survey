DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432
# Bounded DB behavior (shown defaults). Statement timeout is server-side;
# query/acquisition timeouts bound client waits; TCP keepalive detects dead peers.
DB_POOL_MAX=10
DB_POOL_MAX_LIFETIME_SECONDS=1800
DB_POOL_ACQUIRE_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=9000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
DB_SOCKET_KEEPALIVE_DELAY_MS=5000
HEALTH_DB_TIMEOUT_MS=2000
RUNTIME_METRIC_NAMESPACE=NetworkSurvey/Runtime
FRONTEND_URL=http://localhost:3001
SURVEY_URL=http://localhost:3002
# Optional comma-separated legacy survey origins accepted by API CORS.
SURVEY_ALLOWED_ORIGINS=
NODE_ENV=development
SESSION_SECRET=replace-me
# Public dashboard signup defaults to enabled only for local/dev/test.
# Set false for production/staging unless invite/admin-created accounts are explicitly supported.
ALLOW_PUBLIC_SIGNUP=true
# Optional throttling overrides (15-minute windows).
AUTH_RATE_LIMIT_MAX=20
RESPONDENT_RATE_LIMIT_MAX=120
DEMO_EMAIL_RATE_LIMIT_MAX=10
# Optional dedicated signing secret for 24-hour demo links; defaults to SESSION_SECRET.
# DEMO_TOKEN_SECRET=replace-me
# Optional for email sending features.
RESEND_API_KEY=replace-me
# Durable lifecycle launch/worker settings.
SURVEY_DELIVERY_V2_ENABLED=true
LEGACY_START_ENABLED=true
RESEND_PROVIDER_ACCOUNT_SCOPE=network-survey-resend-team
RESEND_WEBHOOK_INGEST_ENABLED=false
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_PREVIOUS_SECRET=
WEBHOOK_PAYLOAD_RETENTION_DAYS=30
WEBHOOK_METRIC_NAMESPACE=NetworkSurvey/Email
EMAIL_WORKER_ENV=local
EMAIL_WORKER_HEARTBEAT_MAX_AGE_SECONDS=45
EMAIL_LEASE_SECONDS=60
EMAIL_PROVIDER_TIMEOUT_MS=15000
EMAIL_MAX_ATTEMPTS=6
EMAIL_MAX_AGE_HOURS=72
EMAIL_RATE_PER_SECOND=5
SURVEY_EMAIL_SENDER=CLA Survey <survey@cladvisors.com>
# Optional for local DB bootstrap admin created by `npm run db:setup`.
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin123
# Safety valve. Keep false for normal local workflows.
ALLOW_NON_LOCAL_DB_SETUP=false